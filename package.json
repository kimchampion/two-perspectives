{
  "name": "two-perspectives",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "build:copyable": "python3 scripts/build-copyable.py",
    "package:files": "npm run build:standalone && python3 scripts/package-downloads.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/run.js",
    "format": "prettier --write src tests index.html vite.config.js README.md package.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
